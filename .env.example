# From https://resend.com/api-keys — this stays on the server, not in the browser.
RESEND_API_KEY=

# Until a domain is verified, Resend only delivers from onboarding@resend.dev,
# and only to the email address on the Resend account.
RESEND_FROM=Ribbon <onboarding@resend.dev>

# Public Supabase project. The anon key is safe in the browser; the service role is not.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe secret key (sk_test_... or sk_live_...). Checkout is $2.99 once for 100 people.
STRIPE_SECRET_KEY=

# Leave empty while developing. Vite serves /api on the same origin.
# On Vercel, set this to the Railway URL, including https://, with no trailing slash, then rebuild.
VITE_API_URL=

# Railway. The Vercel site origin, used for browser access and Stripe's return page.
# Example: https://ribbon.vercel.app
CORS_ORIGIN=
APP_ORIGIN=
